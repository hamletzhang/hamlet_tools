; Engine Configuration File
; Godot version: 4.6.3-stable
; Project: 星际守卫者 (Star Defender) - 2D飞机射击游戏Demo
; 开发规范:
;   - GDScript 2.0 渐进式类型系统，关键变量显式标注类型
;   - 节点引用使用 @onready 懒加载
;   - 配置参数使用 @export 暴露到编辑器Inspector
;   - 信号命名使用过去式 (如 health_changed, enemy_died)
;   - 类名 PascalCase, 变量/函数 snake_case, 常量 UPPER_SNAKE_CASE
;   - 所有注释使用中文，代码不超过120字符/行
;   - 组合优于继承：功能拆分为独立场景组件
;   - 全局状态通过 AutoLoad 单例管理，避免节点间直接引用

[application]
config/name="星际守卫者"
config/description="2D俯视角飞机射击游戏Demo - 用于验证Godot引擎与AI辅助开发流程"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]
GameManager="*res://scripts/game_manager.gd"

[display]
window/size/viewport_width=480
window/size/viewport_height=854
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

